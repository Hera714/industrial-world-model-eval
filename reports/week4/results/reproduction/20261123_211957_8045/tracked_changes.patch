diff --git a/controllers/mpc.py b/controllers/mpc.py
index e69de29..d08e357 100644
--- a/controllers/mpc.py
+++ b/controllers/mpc.py
@@ -0,0 +1,88 @@
+# 总说明：随机 shooting MPC，使用带噪观测和无噪声热工模型规划，并提供可记录的规则回退。
+from dataclasses import dataclass
+import time
+import numpy as np
+from controllers.rule_based import HysteresisController
+from simulators.simple_thermal import ThermalConfig
+
+@dataclass(frozen=True)
+class MPCConfig:
+    horizon: int = 12
+    candidates: int = 256
+    tracking_weight: float = 1.0
+    energy_weight: float = 1.0
+    action_change_weight: float = 0.02
+    comfort_penalty_weight: float = 2.0
+    terminal_weight: float = 0.0
+    time_budget_s: float = 1.0
+    seed: int = 123
+    def __post_init__(self):
+        if not isinstance(self.horizon,int) or isinstance(self.horizon,bool) or self.horizon<1 or not isinstance(self.candidates,int) or isinstance(self.candidates,bool) or self.candidates<1: raise ValueError('时域和候选数必须是正整数')
+        values=[self.tracking_weight,self.energy_weight,self.action_change_weight,self.comfort_penalty_weight,self.terminal_weight,self.time_budget_s]
+        if not np.isfinite(values).all() or min(values)<0 or self.time_budget_s<=0: raise ValueError('权重应非负且时间预算应为正')
+
+class RandomShootingMPC:
+    def __init__(self, thermal=None, config=None, clock=None, dynamics=None):
+        self.thermal=thermal or ThermalConfig(); self.config=config or MPCConfig()
+        self.dynamics=dynamics  # 可注入学习模型；None 表示环境已知无噪声方程。
+        self.clock=clock or time.perf_counter
+        self.fallback=HysteresisController(self.thermal.target_c,.5,self.thermal.max_power_kw)
+        self.reset()
+    def reset(self):
+        # 每回合重置规划随机数和上一次实际输出动作。
+        self.rng=np.random.default_rng(self.config.seed); self.previous_action=0.0; self.fallback.reset()
+    def _plan(self, obs, start):
+        c=self.thermal; p=self.config
+        # 候选动作独立均匀采样，并固定当前观测室外温度为整个时域的天气预测。
+        actions=self.rng.uniform(0,c.max_power_kw,size=(p.candidates,p.horizon))
+        air=np.full(p.candidates,obs[0],dtype=float); wall=np.full(p.candidates,obs[1],dtype=float)
+        outside=float(obs[2]); prev=np.full(p.candidates,self.previous_action); costs=np.zeros(p.candidates)
+        for step in range(p.horizon):
+            # 时间预算在每个向量化预测步前检查，不能抢占正在执行的 NumPy 调用。
+            if self.clock()-start >= p.time_budget_s: return None,'timeout'
+            u=actions[:,step]; exchange=c.air_wall_conductance*(wall-air)
+            if self.dynamics is None:
+                next_air=air+c.dt_hours/c.air_capacity*(exchange+c.air_out_conductance*(outside-air)+u+c.internal_load_kw)
+                next_wall=wall+c.dt_hours/c.wall_capacity*(-exchange+c.wall_out_conductance*(outside-wall))
+            else:
+                predicted=self.dynamics.predict_next(np.column_stack([air,wall]),u,outside)
+                if np.shape(predicted)!=(p.candidates,2): raise ValueError('动力学输出形状无效')
+                next_air,next_wall=predicted[:,0],predicted[:,1]
+            violation=np.maximum(c.comfort_low_c-next_air,0)+np.maximum(next_air-c.comfort_high_c,0)
+            costs+=p.tracking_weight*(next_air-c.target_c)**2+p.energy_weight*u*c.dt_hours+p.action_change_weight*(u-prev)**2+p.comfort_penalty_weight*violation**2
+            air,wall,prev=next_air,next_wall,u
+        costs+=p.terminal_weight*(air-c.target_c)**2
+        if self.clock()-start >= p.time_budget_s: return None,'timeout'
+        valid=np.isfinite(costs)&np.isfinite(actions).all(axis=1)
+        if not valid.any(): return None,'no_valid_candidates'
+        costs[~valid]=np.inf
+        return float(actions[np.argmin(costs),0]),None
+    def act(self, observation):
+        start=self.clock(); reason=None; error_message=None
+        try:
+            obs=np.asarray(observation,dtype=float)
+            if obs.shape!=(3,) or not np.isfinite(obs).all():
+                # 输入非法时无法让规则控制器安全判断，使用明确的零功率后备。
+                action=0.0; reason='invalid_observation'
+            else:
+                with np.errstate(over='ignore',invalid='ignore'):
+                    action,reason=self._plan(obs,start)
+                if reason:
+                    # 依据上一步实际动作初始化滞回记忆，再读取当前观测。
+                    self.fallback.reset(heating_on=self.previous_action>0)
+                    action=float(self.fallback.act(obs)[0])
+                elif not np.isfinite(action) or not 0<=action<=self.thermal.max_power_kw:
+                    reason='invalid_planned_action'
+                    self.fallback.reset(heating_on=self.previous_action>0)
+                    action=float(self.fallback.act(obs)[0])
+        except Exception as exc:
+            # 规划数值异常优先使用规则控制，观测非法时退到零功率。
+            reason='planning_error:'+type(exc).__name__; error_message=str(exc)
+            try:
+                self.fallback.reset(heating_on=self.previous_action>0)
+                action=float(self.fallback.act(observation)[0])
+            except (ValueError,TypeError):
+                action=0.0; reason='invalid_observation'
+        elapsed=max(0.0,self.clock()-start)
+        self.previous_action=action
+        return np.array([action],dtype=np.float32),{'planning_time_s':elapsed,'fallback_reason':reason,'error_message':error_message}
diff --git a/controllers/rule_based.py b/controllers/rule_based.py
index e69de29..c2f94f9 100644
--- a/controllers/rule_based.py
+++ b/controllers/rule_based.py
@@ -0,0 +1,21 @@
+# 总说明：基于观测室温实现带滞回的开关控制；只输出加热功率，不读取真实状态。
+import numpy as np
+
+class HysteresisController:
+    """低于下限开启，高于上限关闭，等于阈值或位于区间内保持状态。"""
+    def __init__(self, target_c=21.0, deadband_c=0.5, heating_power_kw=5.0):
+        if not np.isfinite([target_c,deadband_c,heating_power_kw]).all() or deadband_c<=0 or heating_power_kw<0:
+            raise ValueError('控制参数必须有限，死区大于零，加热功率非负')
+        self.target_c=float(target_c); self.deadband_c=float(deadband_c); self.heating_power_kw=float(heating_power_kw)
+        self.reset()
+    def reset(self, heating_on=False):
+        # 每个新回合显式重置控制器的开关记忆。
+        if not isinstance(heating_on, (bool, np.bool_)): raise ValueError('开关初始状态必须为布尔值')
+        self.heating_on=bool(heating_on)
+    def act(self, observation):
+        # 观测顺序由热工环境定义：室温、墙温、室外温度。
+        obs=np.asarray(observation,dtype=float)
+        if obs.shape!=(3,) or not np.isfinite(obs).all(): raise ValueError('观测必须是三个有限数值')
+        if obs[0] < self.target_c-self.deadband_c: self.heating_on=True
+        elif obs[0] > self.target_c+self.deadband_c: self.heating_on=False
+        return np.array([self.heating_power_kw if self.heating_on else 0.0],dtype=np.float32)
diff --git a/data/collect_trajectories.py b/data/collect_trajectories.py
index e69de29..eef7a7a 100644
--- a/data/collect_trajectories.py
+++ b/data/collect_trajectories.py
@@ -0,0 +1,62 @@
+# 总说明：用随机分段动作和滞回控制采集完整回合，保留真实状态、带噪观测及动作时间。
+import numpy as np
+import pandas as pd
+from dataclasses import asdict
+import hashlib
+import json
+from simulators.simple_thermal import SimpleThermalEnv, ThermalConfig
+from controllers.rule_based import HysteresisController
+
+def collect_episodes(n_episodes=45, base_seed=1000, config=None, policies=('random', 'rule')):
+    cfg=config or ThermalConfig(); rows=[]
+    # 配置指纹区分不同物理参数；每条记录携带完整配置便于独立追溯。
+    config_json = json.dumps(asdict(cfg), sort_keys=True)
+    config_id = hashlib.sha256(config_json.encode()).hexdigest()[:16]
+    for ep in range(n_episodes):
+        env=SimpleThermalEnv(cfg); rng=np.random.default_rng(base_seed+10000+ep)
+        init_air=float(rng.uniform(17,23)); init_wall=float(rng.uniform(17,22))
+        obs,info=env.reset(seed=base_seed+ep,options={'initial_air_c':init_air,'initial_wall_c':init_wall})
+        ctrl=HysteresisController(cfg.target_c,.5,cfg.max_power_kw); ctrl.reset()
+        policy=policies[ep % len(policies)]; action=0.
+        if policy == 'mpc':
+            from controllers.mpc import RandomShootingMPC, MPCConfig
+            ctrl = RandomShootingMPC(cfg, MPCConfig(seed=base_seed+10000+ep))
+        elif policy not in ('random', 'rule'):
+            raise ValueError('Unknown collection policy')
+        for step in range(cfg.episode_steps):
+            before=obs.copy()
+            if policy=='random':
+                if step%6==0: action=float(rng.uniform(0,cfg.max_power_kw))
+                u=np.array([action],dtype=np.float32)
+            elif policy == 'mpc': u, _ = ctrl.act(before)
+            else: u=ctrl.act(before)
+            obs,_,term,trunc,info=env.step(u)
+            scenario_id = f'thermal_{config_id}_air{init_air:.8f}_wall{init_wall:.8f}'
+            # 规范数组用 JSON 字符串存入 DataFrame，CSV 导出后可用 json.loads 恢复。
+            transition = {
+                'schema_version': '1.0',
+                'episode_id': f'{scenario_id}_seed{base_seed+ep}_episode{ep}',
+                'scenario_id': scenario_id, 'seed': base_seed+ep,
+                'policy_seed': base_seed+10000+ep, 'source_step': step,
+                'time': step*cfg.dt_hours, 'next_time': (step+1)*cfg.dt_hours,
+                'dt': cfg.dt_hours, 'time_unit': 'hour', 'action_hold_steps': 1,
+                'state': json.dumps(info['state_before_c'].tolist()),
+                'observation': json.dumps(before.tolist()),
+                'action_requested': json.dumps(u.tolist()),
+                'action_applied': json.dumps([info['action_kw']]),
+                'exogenous': json.dumps([info['outdoor_used_c'], info['internal_load_kw']]),
+                'exogenous_available_at_decision': json.dumps([float(before[2]), info['internal_load_kw']]),
+                'next_state': json.dumps(info['true_state_c'].tolist()),
+                'next_observation': json.dumps(obs.tolist()),
+                'process_noise': json.dumps(info['process_noise_c'].tolist()),
+                'cost': info['cost'], 'energy_kwh': info['energy_kwh'],
+                'config_id': config_id, 'environment_config': config_json,
+                'end_reason': 'time_limit' if trunc else ('environment_terminal' if term else ''),
+            }
+            rows.append({**transition,'episode':ep,'step':step,'policy':policy,'environment_seed':base_seed+ep,
+              'air':info['state_before_c'][0],'wall':info['state_before_c'][1],'outdoor':info['outdoor_used_c'],
+              'observed_air':before[0],'observed_wall':before[1],'observed_outdoor':before[2],
+              'action':info['action_kw'],'next_air':info['true_state_c'][0],'next_wall':info['true_state_c'][1],
+              'terminated':term,'truncated':trunc})
+            if term or trunc: break
+    return pd.DataFrame(rows)
diff --git a/data/preprocess.py b/data/preprocess.py
index e69de29..de65f74 100644
--- a/data/preprocess.py
+++ b/data/preprocess.py
@@ -0,0 +1,116 @@
+"""Week 1：时间对齐、无未来泄漏的预处理及直接多步预测窗口。"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import numpy as np
+import pandas as pd
+
+try:
+    from .split import split_by_time, target_windows
+except ImportError:
+    from split import split_by_time, target_windows
+
+FEATURES = ["T1", "T2", "T3", "RH_1", "T_out"]
+TARGET = "T1"
+NAMES = ("train", "val", "test")
+
+
+def prepare_frame(df, features=FEATURES, frequency="10min", fill_limit=6):
+    """检查时间网格并标记缺失；仅以前向填充使用过去观测。"""
+    if fill_limit < 1:
+        raise ValueError("fill_limit 必须为正数")
+    required = ["date", *features]
+    missing_cols = set(required) - set(df.columns)
+    if missing_cols:
+        raise ValueError(f"缺少字段: {sorted(missing_cols)}")
+    frame = df[required].copy()
+    frame["date"] = pd.to_datetime(frame["date"], errors="raise")
+    if frame.date.isna().any() or frame.date.duplicated().any() or frame.empty:
+        raise ValueError("时间戳不能为空、重复，数据不能为空")
+    frame = frame.sort_values("date").set_index("date")
+    grid = pd.date_range(frame.index[0], frame.index[-1], freq=frequency)
+    if not frame.index.isin(grid).all():
+        raise ValueError("存在不在固定时间网格上的记录；请先检查采样时间")
+    for col in features:
+        frame[col] = pd.to_numeric(frame[col], errors="raise")
+        if np.isinf(frame[col].to_numpy()).any():
+            raise ValueError(f"{col} 含无穷值")
+    missing_timestamps = len(grid) - len(frame)
+    aligned = frame.reindex(grid)
+    aligned.index.name = "date"
+    flags = aligned[features].isna().astype(np.uint8)
+    flags.columns = [f"{c}_missing" for c in features]
+    # 真实目标不填补；缺失目标的窗口将被丢弃。
+    target_observed = aligned[TARGET].notna().to_numpy()
+    filled = aligned[features].ffill(limit=fill_limit)
+    return filled.reset_index(), flags.reset_index(drop=True), target_observed, {
+        "frequency": frequency, "inserted_timestamps": missing_timestamps,
+        "missing_before_fill": {c: int(aligned[c].isna().sum()) for c in features},
+        "missing_after_fill": {c: int(filled[c].isna().sum()) for c in features},
+        "forward_fill_limit_steps": fill_limit,
+    }
+
+
+def build_dataset(df, history=144, horizon=24, features=FEATURES, fill_limit=6):
+    """仅在训练时段拟合标准化，返回各集合窗口、缺失标记和元数据。"""
+    if TARGET not in features:
+        raise ValueError("特征必须包含目标 T1")
+    frame, flags, observed, diagnostics = prepare_frame(df, features, fill_limit=fill_limit)
+    splits = split_by_time(frame)
+    # 重用切分模块检查所有候选目标窗口均属于对应区间。
+    candidates = target_windows(splits, history, horizon)
+    train_n = len(splits["train"])
+    train = frame.loc[:train_n - 1, features]
+    means = train.mean()
+    scales = train.std(ddof=0).replace(0, 1.0)
+    if means.isna().any() or scales.isna().any():
+        raise ValueError("训练集存在无法计算标准化参数的特征")
+    values = ((frame[features] - means) / scales).to_numpy(dtype=np.float32)
+    missing_flags = flags.to_numpy(dtype=np.uint8)
+    times = pd.DatetimeIndex(frame.date)
+    target_idx = features.index(TARGET)
+    result = {}
+    summary = {"history": history, "horizon": horizon, "features": features, "target": TARGET,
+               "diagnostics": diagnostics, "scaler": {"fit_partition": "train", "mean": means.to_dict(), "scale": scales.to_dict()}, "splits": {}}
+    for name in NAMES:
+        X, Y, masks, starts = [], [], [], []
+        rejected = 0
+        for target_times in candidates[name]:
+            start = times.get_loc(target_times[0])
+            x = values[start-history:start]
+            y = values[start:start+horizon, target_idx]
+            # 目标必须是真实观测，输入必须在有限前向填充后可用。
+            if not np.isfinite(x).all() or not observed[start:start+horizon].all():
+                rejected += 1
+                continue
+            X.append(x); Y.append(y); masks.append(missing_flags[start-history:start]); starts.append(start)
+        if not X:
+            raise ValueError(f"{name} 没有可用窗口")
+        result[name] = {"X": np.stack(X), "y": np.stack(Y), "missing_mask": np.stack(masks),
+                        "target_start": times[np.array(starts)].to_numpy(dtype="datetime64[ns]")}
+        part = splits[name]
+        summary["splits"][name] = {"start": part.date.iloc[0].isoformat(), "end": part.date.iloc[-1].isoformat(),
+            "rows": len(part), "candidate_windows": len(candidates[name]), "windows": len(X), "discarded_windows": rejected}
+    return result, summary
+
+
+def main():
+    parser = argparse.ArgumentParser(description="构造无未来泄漏的时序预测窗口")
+    parser.add_argument("--data", default="data/raw/energydata_complete.csv")
+    parser.add_argument("--output", default="data/processed/week1")
+    parser.add_argument("--history", type=int, default=144)
+    parser.add_argument("--horizon", type=int, default=24)
+    args = parser.parse_args()
+    datasets, summary = build_dataset(pd.read_csv(args.data), args.history, args.horizon)
+    out = Path(args.output); out.mkdir(parents=True, exist_ok=True)
+    for name, arrays in datasets.items():
+        np.savez_compressed(out / f"{name}.npz", **arrays)
+    (out / "metadata.json").write_text(json.dumps(summary, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(summary, ensure_ascii=False, indent=2))
+    print(f"已保存至 {out}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/data/split.py b/data/split.py
index e69de29..35f6f04 100644
--- a/data/split.py
+++ b/data/split.py
@@ -0,0 +1,110 @@
+"""按时间划分数据，并检查滑动窗口的预测目标是否跨界。"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+
+def split_by_time(df: pd.DataFrame) -> dict[str, pd.DataFrame]:
+    """排序后按 70%/15%/15% 划分；切分边界只由行数决定。"""
+    if "date" not in df:
+        raise ValueError("缺少 date 列")
+    data = df.copy()
+    data["date"] = pd.to_datetime(data["date"], errors="raise")
+    if data["date"].isna().any() or data["date"].duplicated().any():
+        raise ValueError("时间戳不能缺失或重复")
+    data = data.sort_values("date", kind="stable").reset_index(drop=True)
+    n = len(data)
+    a, b = int(n * 0.70), int(n * 0.85)
+    if a == 0 or a == b or b == n:
+        raise ValueError("数据不足以分成三个非空集合")
+    return {"train": data.iloc[:a].copy(), "val": data.iloc[a:b].copy(), "test": data.iloc[b:].copy()}
+
+
+def target_windows(splits: dict[str, pd.DataFrame], history: int, horizon: int) -> dict[str, list[pd.DatetimeIndex]]:
+    """生成目标时间窗口。验证/测试可使用切分边界之前的历史观测。"""
+    if history < 1 or horizon < 1:
+        raise ValueError("history 和 horizon 必须为正整数")
+    dates = pd.DatetimeIndex(pd.concat([splits[k]["date"] for k in ("train", "val", "test")], ignore_index=True))
+    if dates.has_duplicates or not dates.is_monotonic_increasing:
+        raise ValueError("切分必须按 train、val、test 时间顺序排列，且时间戳唯一")
+    result = {}
+    offset = 0
+    for name in ("train", "val", "test"):
+        end = offset + len(splits[name])
+        # start 是目标第一个时间点；必须有足够历史，且完整目标留在本集合内。
+        starts = range(max(offset, history), end - horizon + 1)
+        result[name] = [dates[start:start + horizon] for start in starts]
+        if not result[name]:
+            raise ValueError(f"{name} 没有完整窗口，请调整历史长度或预测长度")
+        offset = end
+    validate_target_windows(splits, result)
+    return result
+
+
+def validate_target_windows(splits: dict[str, pd.DataFrame], windows: dict[str, list[pd.DatetimeIndex]]) -> None:
+    """验证目标属于各自切分，并检查不同集合的目标时间不重叠。"""
+    targets = {}
+    for name in ("train", "val", "test"):
+        allowed = set(pd.to_datetime(splits[name]["date"]))
+        targets[name] = {t for window in windows[name] for t in window}
+        if not targets[name] or not targets[name].issubset(allowed):
+            raise ValueError(f"{name} 的目标为空或越过切分边界")
+    for left, right in (("train", "val"), ("train", "test"), ("val", "test")):
+        if targets[left] & targets[right]:
+            raise ValueError(f"{left} 和 {right} 的目标时间重叠")
+
+
+def split_by_episode(frame, seed=2026):
+    """按策略分层打乱完整回合，70/15/15 分配，返回数据及 ID 清单。"""
+    if frame.duplicated(['episode_id', 'source_step']).any():
+        raise ValueError('Duplicate transition')
+    counts = frame.groupby('episode_id').policy.nunique()
+    if (counts != 1).any():
+        raise ValueError('Episode policy must be unique')
+    rng = np.random.default_rng(seed)
+    manifest = {name: [] for name in ('train', 'val', 'test')}
+    episodes = frame[['episode_id', 'policy']].drop_duplicates()
+    for _, group in episodes.groupby('policy', sort=True):
+        ids = rng.permutation(sorted(group.episode_id))
+        first, second = int(len(ids)*.7), int(len(ids)*.85)
+        if first == 0 or first == second or second == len(ids):
+            raise ValueError('Insufficient episodes per policy')
+        for name, values in zip(manifest, (ids[:first], ids[first:second], ids[second:])):
+            manifest[name].extend(values.tolist())
+    parts = {name: frame[frame.episode_id.isin(ids)].copy() for name, ids in manifest.items()}
+    if sum(map(len, parts.values())) != len(frame):
+        raise AssertionError('Split lost transitions')
+    for left, right in (('train','val'),('train','test'),('val','test')):
+        if set(manifest[left]) & set(manifest[right]):
+            raise AssertionError('Episode overlap')
+        if set(parts[left].scenario_id) & set(parts[right].scenario_id):
+            raise ValueError('Scenario overlap; use grouped scenario assignment')
+    return parts, manifest
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="按时间切分数据并验证目标窗口")
+    parser.add_argument("--data", default="data/raw/energydata_complete.csv")
+    parser.add_argument("--history", type=int, default=144)
+    parser.add_argument("--horizon", type=int, default=24)
+    parser.add_argument("--output", default="reports/week1_split.json")
+    args = parser.parse_args()
+    splits = split_by_time(pd.read_csv(args.data))
+    windows = target_windows(splits, args.history, args.horizon)
+    summary = {"history": args.history, "horizon": args.horizon, "target_overlap_check": "passed", "splits": {}}
+    for name, part in splits.items():
+        summary["splits"][name] = {"start": part.date.iloc[0].isoformat(), "end": part.date.iloc[-1].isoformat(), "rows": len(part), "windows": len(windows[name]), "first_target": windows[name][0][0].isoformat(), "last_target": windows[name][-1][-1].isoformat()}
+    output = Path(args.output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    output.write_text(json.dumps(summary, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(summary, ensure_ascii=False, indent=2))
+    print(f"切分记录已保存：{output}")
+
+
+if __name__ == "__main__":
+    main()
