@@ -0,0 +1,77 @@
+"""用 Gymnasium 接口运行 BOPTEST 案例内置控制器。"""
+import json
+from urllib.request import Request, urlopen
+
+import numpy as np
+from gymnasium import spaces
+from simulators.base_env import BaseEnv
+
+
+class BoptestEnv(BaseEnv):
+    """唯一动作 0 表示保持案例内置控制，不发送覆盖命令。"""
+
+    def __init__(self, config):
+        super().__init__()
+        self.config = config
+        self.action_space = spaces.Discrete(1)
+        self.observation_space = spaces.Box(-np.inf, np.inf, (len(config["measurements"]),), dtype=np.float64)
+        self.testid = None
+        self.done = True
+
+    def request(self, method, path, data=None):
+        """检查 HTTP 状态及服务响应状态。推进请求失败时由调用方结束回合。"""
+        request = Request(self.config["url"].rstrip("/") + path,
+                          None if data is None else json.dumps(data).encode(),
+                          {"Content-Type": "application/json"}, method=method)
+        with urlopen(request, timeout=120) as response:
+            # 本地服务的 stop 成功响应是文本，不是 JSON。
+            if method == "PUT" and path.startswith("/stop/"):
+                return None
+            result = json.load(response)
+        if result.get("status", 200) != 200:
+            raise RuntimeError(result.get("message", path))
+        return result.get("payload", result)
+
+    def _sample(self, points):
+        obs = np.array([points[name] for name in self.config["measurements"]], dtype=np.float64)
+        if not np.isfinite(obs).all():
+            raise RuntimeError("BOPTEST returned nonfinite measurements")
+        return obs, {"step": self.steps, "timestamp": points["time"], "measurements": points}
+
+    def reset(self, *, seed=None, options=None):
+        if options:
+            raise ValueError("Configure the test window in the environment configuration")
+        super().reset(seed=seed)
+        self.close()
+        cfg = self.config
+        # 服务端按 JSON 解析请求，案例选择也要发送空对象。
+        self.testid = self.request("POST", "/testcases/" + cfg["case"] + "/select", {})["testid"]
+        self.request("PUT", f"/step/{self.testid}", {"step": cfg["step_seconds"]})
+        points = self.request("PUT", f"/initialize/{self.testid}",
+                              {"start_time": cfg["start_time"], "warmup_period": cfg["warmup_seconds"]})
+        self.steps = 0
+        sample = self._sample(points)
+        self.done = False
+        return sample
+
+    def step(self, action):
+        if self.done:
+            raise RuntimeError("Call reset before step")
+        if not self.action_space.contains(action):
+            raise ValueError("Action 0 selects embedded control")
+        # 失败后需要重新初始化，避免重试推进同一个时间步。
+        self.done = True
+        points = self.request("POST", f"/advance/{self.testid}", {})
+        self.steps += 1
+        obs, info = self._sample(points)
+        expected = self.config["start_time"] + self.steps * self.config["step_seconds"]
+        if info["timestamp"] != expected:
+            raise RuntimeError(f"Unexpected BOPTEST time: {info['timestamp']} != {expected}")
+        self.done = self.steps >= self.config["episode_steps"]
+        return obs, 0.0, False, self.done, info
+
+    def close(self):
+        self.done = True
+        if self.testid is not None:
+            self.request("PUT", f"/stop/{self.testid}", {})
+            self.testid = None
diff --git a/simulators/industrial_benchmark.py b/simulators/industrial_benchmark.py
index e69de29..3b91830 100644
--- a/simulators/industrial_benchmark.py
+++ b/simulators/industrial_benchmark.py
@@ -0,0 +1,87 @@
+"""把 Siemens IB 的旧 Gym 接口转换成可复现的 Gymnasium 环境。"""
+from contextlib import contextmanager
+from copy import deepcopy
+from threading import RLock
+import numpy as np
+from gymnasium import spaces
+from simulators.base_env import BaseEnv
+
+_RNG_LOCK = RLock()
+
+
+class IndustrialBenchmarkEnv(BaseEnv):
+    """三维增量动作，六维公开观测，时间单位为 step。"""
+    metadata = {'render_modes': []}
+
+    def __init__(self, setpoint=50, max_episode_steps=1000):
+        super().__init__()
+        if not np.isfinite(setpoint) or not 0 <= setpoint <= 100:
+            raise ValueError('setpoint must be finite and in [0, 100]')
+        if isinstance(max_episode_steps, bool) or not isinstance(max_episode_steps, int) or max_episode_steps < 1:
+            raise ValueError('max_episode_steps must be a positive integer')
+        self.setpoint = float(setpoint)
+        self.max_episode_steps = max_episode_steps
+        self.action_space = spaces.Box(-1, 1, (3,), dtype=np.float32)
+        self.observation_space = spaces.Box(np.zeros(6, dtype=np.float32), np.array([100, 100, 100, 100, 1000, 1000], dtype=np.float32))
+        self._done = True
+        self._upstream = None
+
+    @contextmanager
+    def _random_context(self):
+        """上游使用全局 NumPy 随机源，逐实例保存并恢复以支持交错运行。"""
+        with _RNG_LOCK:
+            outside = np.random.get_state()
+            np.random.set_state(self._rng_state)
+            try:
+                yield
+            finally:
+                self._rng_state = np.random.get_state()
+                np.random.set_state(outside)
+
+    def _info(self):
+        """内部隐藏状态只放诊断字段，公开观测保持六维。"""
+        return {'step': self.step_count, 'time_unit': 'step', 'cost': float(self._upstream.IB.state['cost']), 'upstream_info': deepcopy(self._upstream.info)}
+
+    def reset(self, *, seed=None, options=None):
+        """显式种子重建上游；无种子重置从 Gymnasium 随机源派生新种子。"""
+        options = options or {}
+        if set(options) - {'setpoint'}:
+            raise ValueError('Unknown reset option')
+        setpoint = options.get('setpoint', self.setpoint)
+        if not np.isfinite(setpoint) or not 0 <= setpoint <= 100:
+            raise ValueError('setpoint must be finite and in [0, 100]')
+        super().reset(seed=seed)
+        upstream_seed = int(self.np_random.integers(0, 2**31))
+        self._rng_state = np.random.RandomState(upstream_seed).get_state()
+        # 上游旧版别名的等价兼容，导入后执行原始动力学。
+        with self._random_context():
+            np.float = float
+            np.int = int
+            from industrial_benchmark_python.IBGym import IBGym
+            self._upstream = IBGym(setpoint, init_seed=upstream_seed, reset_after_timesteps=self.max_episode_steps)
+        self.step_count = 0
+        self._done = False
+        return np.asarray(self._upstream.observation, dtype=np.float32).copy(), self._info()
+
+    def step(self, action):
+        """先校验动作，推进一次上游；时间上限映射为 truncated。"""
+        if self._done:
+            raise RuntimeError('Call reset before step or after episode end')
+        try:
+            action = np.asarray(action, dtype=np.float64)
+        except (TypeError, ValueError) as error:
+            raise ValueError('Action must be three finite values in [-1, 1]') from error
+        if action.shape != (3,) or not np.isfinite(action).all() or np.any(np.abs(action) > 1):
+            raise ValueError('Action must be three finite values in [-1, 1]')
+        try:
+            with self._random_context():
+                observation, reward, done, _ = self._upstream.step(action)
+        except Exception:
+            self._done = True
+            raise
+        self.step_count += 1
+        self._done = bool(done)
+        info = self._info()
+        if done:
+            info['end_reason'] = 'time_limit'
+        return np.asarray(observation, dtype=np.float32).copy(), float(reward), False, bool(done), info
diff --git a/simulators/simple_thermal.py b/simulators/simple_thermal.py
index e69de29..b817488 100644
--- a/simulators/simple_thermal.py
+++ b/simulators/simple_thermal.py
@@ -0,0 +1,80 @@
+# 总说明：实现 Gymnasium 二阶热工环境，模拟加热动作、天气扰动、状态转移和噪声。
+import numpy as np
+import gymnasium as gym
+from gymnasium import spaces
+from dataclasses import dataclass, asdict
+
+# 参数使用小时、kW、kWh/°C 和 kW/°C；配置创建后保持不变。
+@dataclass(frozen=True)
+class ThermalConfig:
+    dt_hours: float = 1/6
+    episode_steps: int = 144
+    max_power_kw: float = 5.0
+    target_c: float = 21.0
+    initial_air_c: float = 18.0
+    initial_wall_c: float = 19.0
+    outdoor_mean_c: float = 6.0
+    outdoor_amplitude_c: float = 4.0
+    internal_load_kw: float = 0.3
+    air_capacity: float = 2.0
+    wall_capacity: float = 12.0
+    air_wall_conductance: float = 0.3
+    air_out_conductance: float = 0.15
+    wall_out_conductance: float = 0.1
+    weather_noise_std: float = 0.3
+    process_noise_std: float = 0.01
+    measurement_noise_std: float = 0.05
+    comfort_low_c: float = 20.0
+    comfort_high_c: float = 23.0
+    # 校验参数范围和显式离散更新的稳定性条件。
+    def __post_init__(self):
+        if not all(np.isfinite(v) for v in asdict(self).values()): raise ValueError('Nonfinite configuration')
+        if self.dt_hours<=0 or not isinstance(self.episode_steps,int) or self.episode_steps<1 or self.max_power_kw<=0 or min(self.air_capacity,self.wall_capacity)<=0: raise ValueError('Invalid positive parameter')
+        if min(self.air_wall_conductance,self.air_out_conductance,self.wall_out_conductance,self.weather_noise_std,self.process_noise_std,self.measurement_noise_std)<0 or self.comfort_low_c>=self.comfort_high_c: raise ValueError('Invalid bounds or noise')
+        if self.dt_hours*(self.air_wall_conductance+self.air_out_conductance)/self.air_capacity>1 or self.dt_hours*(self.air_wall_conductance+self.wall_out_conductance)/self.wall_capacity>1: raise ValueError('Unstable time step')
+
+# 环境通过 reset 初始化，通过 step 执行一个控制时段。
+class SimpleThermalEnv(gym.Env):
+    """Action applies over [t,t+1). Comfort is soft; time limit truncates."""
+    metadata={'render_modes':[]}
+    def __init__(self,config=None):
+        super().__init__(); self.config=config or ThermalConfig()
+        self.action_space=spaces.Box(0,self.config.max_power_kw,(1,),dtype=np.float32)
+        self.observation_space=spaces.Box(-np.inf,np.inf,(3,),dtype=np.float32); self._done=True
+    # 生成具有日周期的室外温度，并加入天气扰动。
+    def _outdoor(self,step):
+        c=self.config
+        return float(c.outdoor_mean_c+c.outdoor_amplitude_c*np.sin(2*np.pi*(step*c.dt_hours-8)/24)+self.weather_rng.normal(0,c.weather_noise_std))
+    # 测量噪声仅叠加到观测，不改变真实状态。
+    def _observe(self):
+        noise=self.measurement_rng.normal(0,self.config.measurement_noise_std,3)
+        return (np.array([*self.state,self.outdoor])+noise).astype(np.float32),noise
+    # 从环境随机源派生天气、过程噪声和测量噪声的独立随机流。
+    def reset(self,*,seed=None,options=None):
+        super().reset(seed=seed)
+        seeds=self.np_random.integers(0,np.iinfo(np.uint64).max,3,dtype=np.uint64)
+        self.weather_rng,self.process_rng,self.measurement_rng=(np.random.default_rng(int(x)) for x in seeds)
+        options=options or {}; c=self.config
+        if set(options)-{'initial_air_c','initial_wall_c'}: raise ValueError('Unknown reset option')
+        self.state=np.array([options.get('initial_air_c',c.initial_air_c),options.get('initial_wall_c',c.initial_wall_c)],dtype=np.float64)
+        if not np.isfinite(self.state).all(): raise ValueError('Nonfinite initial state')
+        self.step_count=0; self._done=False; self.outdoor=self._outdoor(0); obs,noise=self._observe()
+        return obs,{'true_state_c':self.state.copy(),'outdoor_c':self.outdoor,'measurement_noise_c':noise.copy(),'target_c':c.target_c,'step':0}
+    # 动作作用于当前时刻到下一时刻；无效动作在状态更新前拒绝。
+    def step(self,action):
+        if self._done: raise RuntimeError('Call reset before step or after episode end')
+        a=np.asarray(action,dtype=np.float64); c=self.config
+        if a.shape!=(1,) or not np.isfinite(a).all() or not 0<=a[0]<=c.max_power_kw: raise ValueError('Action must be one finite value in range')
+        power=float(a[0]); air,wall=self.state; outdoor=self.outdoor
+        # 根据室内、墙体和室外之间的热交换更新真实状态。
+        process=self.process_rng.normal(0,c.process_noise_std,2); exchange=c.air_wall_conductance*(wall-air)
+        na=air+c.dt_hours/c.air_capacity*(exchange+c.air_out_conductance*(outdoor-air)+power+c.internal_load_kw)+process[0]
+        nw=wall+c.dt_hours/c.wall_capacity*(-exchange+c.wall_out_conductance*(outdoor-wall))+process[1]
+        self.state=np.array([na,nw]); self.step_count+=1; self.outdoor=self._outdoor(self.step_count)
+        # 更新观测并记录示例成本；能耗按功率乘步长计算。
+        obs,measurement=self._observe(); energy=power*c.dt_hours; tracking=(na-c.target_c)**2; cost=tracking+energy
+        # 舒适区不触发终止；到达回合长度时仅触发截断。
+        truncated=self.step_count>=c.episode_steps; self._done=truncated
+        # 返回真实状态、噪声和扰动，供实验日志与评测使用。
+        info={'step':self.step_count,'state_before_c':np.array([air,wall]),'true_state_c':self.state.copy(),'action_kw':power,'outdoor_used_c':outdoor,'next_outdoor_c':self.outdoor,'internal_load_kw':c.internal_load_kw,'process_noise_c':process.copy(),'measurement_noise_c':measurement.copy(),'target_c':c.target_c,'energy_kwh':energy,'tracking_cost':tracking,'cost':cost,'comfort_violation':bool(na<c.comfort_low_c or na>c.comfort_high_c)}
+        return obs,-float(cost),False,truncated,info
diff --git a/tests/test_env_contract.py b/tests/test_env_contract.py
index e69de29..7e3530b 100644
--- a/tests/test_env_contract.py
+++ b/tests/test_env_contract.py
@@ -0,0 +1,44 @@
+# 总说明：检验环境接口、随机种子复现、动作响应和回合边界。
+import unittest
+import numpy as np
+from gymnasium.utils.env_checker import check_env
+from simulators.simple_thermal import SimpleThermalEnv, ThermalConfig
+
+class ThermalTest(unittest.TestCase):
+    # 使用 Gymnasium 官方检查器验证接口约定。
+    def test_gym_contract(self):
+        check_env(SimpleThermalEnv(),skip_render_check=True)
+    # 相同种子轨迹相同；改变测量噪声不应改变真实状态。
+    def test_repeatable_and_noise_streams(self):
+        a=SimpleThermalEnv(); b=SimpleThermalEnv()
+        oa,ia=a.reset(seed=42); ob,ib=b.reset(seed=42)
+        np.testing.assert_array_equal(oa,ob)
+        for _ in range(10):
+            x=a.step(np.array([2.0],dtype=np.float32)); y=b.step(np.array([2.0],dtype=np.float32))
+            np.testing.assert_array_equal(x[0],y[0])
+            for k in ('true_state_c','process_noise_c','measurement_noise_c'): np.testing.assert_array_equal(x[4][k],y[4][k])
+        c=SimpleThermalEnv(ThermalConfig(measurement_noise_std=0))
+        c.reset(seed=42); d=SimpleThermalEnv(); d.reset(seed=42)
+        for _ in range(10):
+            ci=c.step([2])[4]; di=d.step([2])[4]
+            np.testing.assert_array_equal(ci['true_state_c'],di['true_state_c'])
+            self.assertEqual(ci['outdoor_used_c'],di['outdoor_used_c'])
+    # 相同状态和扰动下，较大加热功率应提高下一步室温。
+    def test_heating_effect(self):
+        a=SimpleThermalEnv(); b=SimpleThermalEnv(); a.reset(seed=1); b.reset(seed=1)
+        low=a.step([0])[4]; high=b.step([5])[4]
+        self.assertGreater(high['true_state_c'][0],low['true_state_c'][0])
+        self.assertEqual(low['outdoor_used_c'],high['outdoor_used_c'])
+        np.testing.assert_array_equal(low['process_noise_c'],high['process_noise_c'])
+    # 非法动作不得推进环境；时间上限应返回截断而非自然终止。
+    def test_invalid_actions_and_end(self):
+        env=SimpleThermalEnv(ThermalConfig(episode_steps=2))
+        with self.assertRaises(RuntimeError): env.step([1])
+        env.reset(seed=2)
+        for a in ([-1],[6],[float('nan')],[float('inf')],[],[1,2]):
+            with self.assertRaises(ValueError): env.step(a)
+        self.assertEqual(env.step_count,0)
+        _,_,term,trunc,_=env.step([1]); self.assertFalse(term or trunc)
+        _,_,term,trunc,_=env.step([1]); self.assertFalse(term); self.assertTrue(trunc)
+        with self.assertRaises(RuntimeError): env.step([1])
+if __name__=='__main__': unittest.main()
diff --git a/tests/test_metrics.py b/tests/test_metrics.py
